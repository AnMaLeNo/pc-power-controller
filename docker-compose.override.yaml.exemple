services:
  api:
    build:
      context: ./power-pc-api
      target: development
    environment:
      - NODE_ENV=development
    ports:
      - "3000:3000"
    volumes:
      - ./power-pc-api:/usr/src/app
      - /usr/src/app/node_modules
  frontend:
    build:
      context: ./frontend
      target: development
    environment:
      - VITE_API_PROXY_TARGET=http://api:3000
    ports:
      - "5174:5173"
    volumes:
      - ./frontend:/usr/src/app
      - /usr/src/app/node_modules
